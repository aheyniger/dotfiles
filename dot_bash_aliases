alias gst='git status' # Gives git status
alias gmt='git commit -m' # Normal commit with message
alias gamt='git commit -a -m' # Commit with message that auto-includes all modified files
alias gamd='git commit --amend --no-edit' # Add staged changes to the most recent commit
alias gpush='git push' # Normal git push
alias gpush-force='git push --force-with-lease' # Push with light force (good after rebases, use with caution)
alias glog='git log' # Interactive log list of git changes
alias glog-ol='git log --oneline' # git log with one line per commit
alias glogn='git log -n' # git log for specific number of commits (need to follow with a number)
alias giff='git diff' # git diff
alias giff-all='git --no-pager diff' # git diff that prints all diff at once
alias gadd='git add' # git add
alias gadda='git add -A' # Stage all changed and untracked files
alias gaddu='git add -u' # Stage all changed files but not untracked/new ones
alias gaddp='git add -p' # Interactive git add to only add certain changes in a file
alias gaddpu='git add -p -u' # Interactive git add for all unstaged (but tracked) changes
alias gunst='git restore --staged' # Unstage a file
alias gsw='git switch' # Switch branches
alias greb='git rebase' # Basic rebase
alias grebi='git rebase -i' # Interactive rebase
alias gfet='git fetch' # Basic fetch
alias gfeto='git fetch origin' # Fetch origin
alias gappl='git apply' # Apply a diff/patch file, or a stashed change
alias gspush='git stash push' # Stash uncommitted changes
alias gspop='git stash pop' # Pop most recently stashed changes
alias gslist='git stash list' # List stashed changes
