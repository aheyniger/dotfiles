checkspace() {
  OPTIND=1

  DEPTH=1
  LOCATION="."
  BLOCKSIZE="M"

  while getopts "l:d:b:s:h" opt; do
    case $opt in
      l) LOCATION=$OPTARG ;;
      d) DEPTH=$OPTARG ;;
      s) BLOCKSIZE=$OPTARG ;;
      b) BLOCKSIZE=$OPTARG ;;
      h) echo "Usage: $0 [-l <location path>] [-d <search depth>] [-<s or b> <blocksize>]"
         return 0 ;;
      *) echo "Invalid option: -$OPTARG" >&2
         return 1 ;;
    esac
  done

  echo "find $LOCATION -maxdepth $DEPTH -exec du -sh {} \; | grep $BLOCKSIZE"
  find $LOCATION -maxdepth $DEPTH -exec du -sh {} \; | grep $BLOCKSIZE
}
